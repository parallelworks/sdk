{
  "name": "@parallelworks/client",
  "version": "7.47.0",
  "description": "Official TypeScript client for Parallel Works ACTIVATE API",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./swr": {
      "import": "./dist/swr/index.js",
      "types": "./dist/swr/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "generate": "openapi-typescript ../openapi.json -o ./src/types/api.d.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "openapi-fetch": "^0.14.0"
  },
  "peerDependencies": {
    "swr": "^2.0.0",
    "swr-openapi": "^5.0.0",
    "openapi-typescript-helpers": "^0.0.15",
    "type-fest": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "swr": {
      "optional": true
    },
    "swr-openapi": {
      "optional": true
    },
    "openapi-typescript-helpers": {
      "optional": true
    },
    "type-fest": {
      "optional": true
    }
  },
  "devDependencies": {
    "openapi-typescript": "^7.9.1",
    "chokidar-cli": "^3.0.0",
    "@types/node": "^22.0.0",
    "openapi-typescript-helpers": "^0.0.15",
    "type-fest": "^5.4.1",
    "typescript": "^5.4.0",
    "swr": "^2.3.6",
    "swr-openapi": "^5.4.1"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/parallelworks/sdk.git",
    "directory": "typescript"
  },
  "author": "Parallel Works <support@parallelworks.com>",
  "license": "MIT"
}
